# Server
PORT=3001
DATABASE_PATH=./data/gitstars.db
SESSION_SECRET=please-change-me-to-a-random-string
# Optional: dedicated key for provider-token encryption (derived from SESSION_SECRET if unset)
CREDENTIAL_KEY=
PUBLIC_URL=http://localhost:3001
COOKIE_SECURE=false

# GitHub OAuth (leave blank to use LOCAL_DEV_USER only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local single-user dev login (leave blank to disable)
LOCAL_DEV_USER=
# Allow dev login when NODE_ENV=production (default false; never enable in production)
ALLOW_DEV_LOGIN=false

# Admin API bearer token (leave blank to disable admin endpoints)
ADMIN_TOKEN=
